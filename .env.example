# Copia este archivo como ".env" y completa los valores

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-aqui-va-tu-clave

# --- Google Drive monitor ---
DRIVE_FOLDER_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs_ejemplo
POLL_INTERVAL=60

# --- Siigo Nube ---
# Registro en: https://developer.siigo.com
SIIGO_USERNAME=tu_email@empresa.com
SIIGO_ACCESS_KEY=tu_access_key_de_siigo
SIIGO_PARTNER_ID=tu_partner_id_de_siigo
SIIGO_SANDBOX=true   # cambiar a false para produccion

# --- Alegra ---
# Token en: Alegra → Configuración → API
ALEGRA_EMAIL=tu_email@empresa.com
ALEGRA_TOKEN=tu_token_de_alegra

# --- Google Sheets (ContaFlow Yamaha) ---
# Contenido del service account JSON en una sola línea (para Railway/prod)
GOOGLE_SHEETS_CREDENTIALS=<contenido del JSON en una sola línea>

# --- Login ContaFlow ---
# Credenciales de acceso a la app (sobreescriben los valores por defecto)
APP_DEMO_EMAIL=demo@contaflow.co
APP_DEMO_PASSWORD=ContaFlow2024
